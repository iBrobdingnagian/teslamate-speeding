{
  "uid": "pagerduty-metrics",
  "title": "PagerDuty",
  "tags": [
    "pagerduty",
    "ops"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**PagerDuty** · incidents and notifications copied every 5 min from PagerDuty (read-only key) by `pagerduty_metrics.py` · Free plan: **100 phone/SMS notifications per month**"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Phone + SMS this month",
      "description": "Phone calls and SMS sent this calendar month. The PagerDuty Free plan includes 100 a month.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"used\" FROM pagerduty.notifications\n        WHERE channel IN ('phone','sms') AND created_at >= date_trunc('month', now())"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Free plan used (of 100)",
