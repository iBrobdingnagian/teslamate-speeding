          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"used\" FROM pagerduty.notifications\n                     WHERE channel IN ('phone','sms') AND created_at >= date_trunc('month', now())"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
