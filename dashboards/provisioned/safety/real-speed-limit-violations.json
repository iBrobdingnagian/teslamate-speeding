          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH inc AS (SELECT i.hour_utc AS h, count(*) AS n FROM speeding_incidents i WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over GROUP BY 1), km AS (SELECT extract(hour FROM start_date)::int AS h, sum(distance) AS km FROM drives WHERE car_id = $car_id AND $__timeFilter(start_date) GROUP BY 1) SELECT km.h AS \"Hour of day (UTC)\", round((100.0 * coalesce(inc.n, 0) / NULLIF(km.km, 0))::numeric, 2) AS \"Incidents per 100 km\" FROM km LEFT JOIN inc ON inc.h = km.h ORDER BY 1",
          "refId": "A"
