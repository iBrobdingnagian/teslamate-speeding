          "rawQuery": true,
          "rawSql": "SELECT i.id, i.drive_id, i.start_ts AS time, COALESCE(i.road_name, i.road_numbers, NULLIF(p.street, '')) AS road, COALESCE(NULLIF(concat_ws(', ', p.street, p.municipality), ''), p.label) AS place, i.speed_limit AS \"limit_$length_unit\", i.max_speed AS \"speed_$length_unit\", convert_km(i.max_over::numeric, '$length_unit') AS \"over_$length_unit\", i.duration_s AS \"seconds\", i.time_saved_s AS \"saved_s\", CASE WHEN i.roadworks_nearby THEN 'roadworks reported' WHEN i.roadworks_nearby IS NULL THEN '' ELSE 'no roadworks' END AS roadworks, CASE WHEN i.congestion_ratio IS NULL THEN 'unknown' WHEN i.congestion_ratio < 0.2 THEN '1 free-flowing' WHEN i.congestion_ratio < 0.5 THEN '2 some traffic' ELSE '3 slow / congested' END AS traffic, i.weather_main AS weather, i.confidence, i.start_lat::float AS latitude, i.start_lon::float AS longitude FROM speeding_incidents i LEFT JOIN speeding_places p ON p.lat_key = round(i.start_lat, 3) AND p.lon_key = round(i.start_lon, 3) WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over ORDER BY i.start_ts DESC LIMIT 2000",
