    {
      "id": 6,
      "type": "stat",
      "title": "Drives checked",
      "description": "Share of drives in range already matched to the road network. Unchecked drives are filled in by the nightly job and by the month-end backfill that spends the unused monthly TomTom quota.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE s.status = 'done') / NULLIF(count(*), 0), 1) AS checked FROM drives d LEFT JOIN speeding_drive_status s ON s.drive_id = d.id WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.distance >= 0.3",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "geomap",
      "title": "Where it happened",
      "description": "One marker per incident at its start; size and colour show how far over the limit. Positions are snapped to the road, so they sit on roads.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT i.id, i.start_ts AS time, i.start_lat::float AS latitude, i.start_lon::float AS longitude, convert_km(i.max_over::numeric, '$length_unit') AS over, COALESCE(i.road_name, i.road_numbers, NULLIF(p.street, '')) AS road, COALESCE(NULLIF(concat_ws(', ', p.street, p.municipality), ''), p.label) AS place, i.speed_limit AS \"limit\", i.max_speed AS speed, i.duration_s AS seconds FROM speeding_incidents i LEFT JOIN speeding_places p ON p.lat_key = round(i.start_lat, 3) AND p.lon_key = round(i.start_lon, 3) WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over ORDER BY i.max_over ASC LIMIT 5000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              },
              {
                "color": "dark-red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "lat": 48,
          "lon": 8,
          "zoom": 6
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Where it happened",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "over",
                  "fixed": 6,
                  "min": 4,
                  "max": 16
                },
                "color": {
                  "field": "over",
                  "fixed": "dark-red"
                },
                "opacity": 0.75,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 8,
      "type": "geomap",
      "title": "Incident path",
      "description": "The snapped path of the incident chosen in 'Incident on path map' above, or click 'Show this incident's path' on a row of the table.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.ord::int AS idx, (c.coord->>1)::float AS latitude, (c.coord->>0)::float AS longitude, i.max_over AS over FROM speeding_incidents i, jsonb_array_elements(i.path->'coordinates') WITH ORDINALITY AS c(coord, ord) WHERE i.id = NULLIF('$incident', '')::int ORDER BY c.ord",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              },
              {
                "color": "dark-red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "lat": 48,
          "lon": 8,
          "zoom": 6
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "route",
            "name": "Incident path",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 5,
                  "min": 2,
                  "max": 10
                },
                "color": {
                  "fixed": "red"
                },
                "opacity": 0.9,
                "arrow": 1
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Time saved by speeding",
      "description": "For each incident: the time the same stretch would have taken at exactly the limit, minus the time it took, added up over the range. It is what speeding actually bought you.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
