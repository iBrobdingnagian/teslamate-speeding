          "rawQuery": true,
          "rawSql": "SELECT convert_km((ceil(i.max_over / 5.0) * 5)::numeric, '$length_unit') AS \"Over the limit by (up to)\", count(*) AS \"Incidents\" FROM speeding_incidents i WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over GROUP BY ceil(i.max_over / 5.0) ORDER BY ceil(i.max_over / 5.0)",
