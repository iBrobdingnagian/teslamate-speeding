          "rawQuery": true,
          "rawSql": "SELECT convert_km(i.speed_limit::numeric, '$length_unit') AS \"limit_$length_unit\", count(*) AS incidents, round(avg(i.max_over), 1) AS \"avg_over\", max(i.max_over) AS \"max_over\", coalesce(sum(i.duration_s), 0) AS seconds FROM speeding_incidents i WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over GROUP BY i.speed_limit ORDER BY incidents DESC",
