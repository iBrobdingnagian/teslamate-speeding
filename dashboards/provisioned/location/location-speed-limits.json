    {
      "id": 42,
      "type": "geomap",
      "title": "Hotspots",
      "description": "One marker per ~100 m spot; size = number of incidents, colour = worst overage.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(i.start_lat, 3)::float AS latitude, round(i.start_lon, 3)::float AS longitude, count(*) AS incidents, max(convert_km(i.max_over::numeric, '$length_unit')) AS over, coalesce(max(COALESCE(NULLIF(concat_ws(', ', p.street, p.municipality), ''), p.label)), '') AS place FROM speeding_incidents i LEFT JOIN speeding_places p ON p.lat_key = round(i.start_lat, 3) AND p.lon_key = round(i.start_lon, 3) WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over GROUP BY round(i.start_lat, 3), round(i.start_lon, 3) ORDER BY incidents ASC LIMIT 3000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              },
              {
                "color": "dark-red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "lat": 48,
          "lon": 8,
          "zoom": 6
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Hotspots",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
