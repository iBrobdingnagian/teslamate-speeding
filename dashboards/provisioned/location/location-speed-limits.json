                "size": {
                  "field": "incidents",
                  "fixed": 6,
                  "min": 5,
                  "max": 26
                },
                "color": {
                  "field": "incidents",
                  "fixed": "dark-red"
                },
                "opacity": 0.75,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
