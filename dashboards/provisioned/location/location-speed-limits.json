        "definition": "SELECT (array_agg(i.id ORDER BY i.max_over DESC))[1] AS __value, concat(coalesce(max(COALESCE(NULLIF(concat_ws(', ', p.street, p.municipality), ''), p.label)), concat(round(i.start_lat, 3), ', ', round(i.start_lon, 3))), '  (', count(*), ' incidents)') AS __text FROM speeding_incidents i LEFT JOIN speeding_places p ON p.lat_key = round(i.start_lat, 3) AND p.lon_key = round(i.start_lon, 3) WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over GROUP BY round(i.start_lat, 3), round(i.start_lon, 3) ORDER BY count(*) DESC, max(i.max_over) DESC LIMIT 100",
