    {
      "id": 47,
      "type": "table",
      "title": "Your custom limits",
      "description": "Add your own limits for places where you know better than the map, for example:\nINSERT INTO speed_limit_overrides (name, latitude, longitude, radius_m, limit_kmh, note) VALUES ('School street', 48.5933, 7.7531, 150, 30, 'zone 30');\nOnly incidents (over TomTom's limit) are counted, so a custom limit lower than TomTom's undercounts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 10,
        "y": 28,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.name AS place, o.limit_kmh AS \"your_limit\", count(i.id) AS \"incidents_here\", count(i.id) FILTER (WHERE i.max_speed > o.limit_kmh + greatest(5, round(0.05 * o.limit_kmh))) AS \"over_your_limit\", max(i.max_speed) AS \"top_speed\", string_agg(DISTINCT i.speed_limit::text, ', ') AS \"tomtom_limit\", o.note FROM speed_limit_overrides o LEFT JOIN speeding_incidents i ON i.car_id = $car_id AND $__timeFilter(i.start_ts) AND sqrt(power((i.start_lat::float - o.latitude::float) * 111320, 2) + power((i.start_lon::float - o.longitude::float) * 111320 * cos(radians(o.latitude::float)), 2)) <= o.radius_m GROUP BY o.id ORDER BY 4 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
