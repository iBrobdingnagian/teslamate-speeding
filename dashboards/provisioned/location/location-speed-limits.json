    {
      "id": 39,
      "type": "stat",
      "title": "Countries",
      "description": "Countries with incidents (from Reverse Geocoding; fills in over the first days).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
