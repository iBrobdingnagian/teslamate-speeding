    {
      "id": 45,
      "type": "table",
      "title": "Limits by country",
      "description": "Where each speed limit gets exceeded, by country.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(p.country, 'unknown') AS country, convert_km(i.speed_limit::numeric, '$length_unit') AS \"limit_$length_unit\", count(*) AS incidents, round(avg(i.max_over), 1) AS \"avg_over\", max(i.max_over) AS \"max_over\" FROM speeding_incidents i LEFT JOIN speeding_places p ON p.lat_key = round(i.start_lat, 3) AND p.lon_key = round(i.start_lon, 3) WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over GROUP BY 1, i.speed_limit ORDER BY 1, i.speed_limit",
          "refId": "A"
        }
      ],
