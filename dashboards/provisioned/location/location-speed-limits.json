    {
      "id": 43,
      "type": "table",
      "title": "Hotspot list",
      "description": "Most repeated spots first. 'limits' are the limits TomTom reports there.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(max(COALESCE(NULLIF(concat_ws(', ', p.street, p.municipality), ''), p.label)), concat(round(i.start_lat, 3), ', ', round(i.start_lon, 3))) AS place, max(p.municipality) AS town, max(p.country) AS country, count(*) AS incidents, count(DISTINCT i.drive_id) AS drives, round(avg(i.max_over), 1) AS \"avg_over\", max(i.max_over) AS \"max_over\", string_agg(DISTINCT i.speed_limit::text, ', ') AS \"limits\", max(i.start_ts) AS \"last_seen\", count(*) FILTER (WHERE i.roadworks_nearby) AS \"with_roadworks\", (array_agg(i.id ORDER BY i.max_over DESC))[1] AS incident_id, round(i.start_lat, 3)::float AS latitude, round(i.start_lon, 3)::float AS longitude FROM speeding_incidents i LEFT JOIN speeding_places p ON p.lat_key = round(i.start_lat, 3) AND p.lon_key = round(i.start_lon, 3) WHERE i.car_id = $car_id AND $__timeFilter(i.start_ts) AND i.max_over >= $min_over GROUP BY round(i.start_lat, 3), round(i.start_lon, 3) ORDER BY incidents DESC, max(i.max_over) DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "latitude"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "longitude"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "incident_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "place"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show the worst incident here on the map",
                    "url": "/d/location_speed_limits?${__url_time_range}&var-car_id=${car_id}&var-min_over=${min_over}&var-spot=${__data.fields.incident_id}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "place"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
