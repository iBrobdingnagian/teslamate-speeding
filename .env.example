# TeslaMate database (the same one TeslaMate writes to)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teslamate
DB_USER=teslamate
DB_PASSWORD=change-me

# TomTom keys: https://developer.tomtom.com (free tier: 2,500 Snap to Roads calls per key per month).
# Add up to three; the client moves to the next key when one runs low or is refused.
TOMTOM_API_KEY=
TOMTOM_API_KEY_2=
TOMTOM_API_KEY_3=

# Optional: Telegram summary after a run
TLG_API=
TLG_CHAT=

# Optional: fill traffic, weather and roadworks columns from extra tables you provide (see README). Off by default.
SPEEDING_CORRELATE=0
