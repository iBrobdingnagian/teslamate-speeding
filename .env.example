# TeslaMate database (the same one TeslaMate writes to)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teslamate
DB_USER=teslamate
DB_PASSWORD=change-me

# TomTom keys: https://developer.tomtom.com (free tier: 2,500 Snap to Roads calls per key per month).
# Add up to three; the client moves to the next key when one runs low or is refused.
TOMTOM_API_KEY=
TOMTOM_API_KEY_2=
TOMTOM_API_KEY_3=

# Optional: Telegram summary after a run
TLG_API=
TLG_CHAT=

# Optional: add context to incidents. weather | traffic | weather,traffic | 0 (default). See README.
SPEEDING_CORRELATE=0

# ---- Notifications (alerts/unified_alert_mqtt.py) -------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=teslamate
TELEGRAM_BOT_TOKEN=          # or TLG_API above
TELEGRAM_CHAT_ID=            # or TLG_CHAT above
TZ=UTC                       # time zone of the message stamps
MAX_ALERTS_PER_HOUR=30
ALERTS_DRY_RUN=0             # 1 = log only, send nothing
# PagerDuty Events API v2 key: opens incidents for a critically low tyre and the charge phone call
PAGERDUTY_ROUTING_KEY=
TYRE_PAGERDUTY_BAR=1.9
CHARGE_CALL_SOC=75
CHARGE_CALL_SAFE_GEOFENCES=^(home|work)\b
CHARGE_CALL_SAFE_RADIUS_M=150
NIGHT_START=23:00
NIGHT_END=07:00
SPEED_ABS_LIMIT_KMH=110
SPEED_ABS_SUSTAIN_S=300
# Nominatim asks for a contact in the User-Agent, e.g. "teslamate-alerts/1.0 (you@example.com)"
NOMINATIM_USER_AGENT=teslamate-alerts/1.0
# PagerDuty metrics collector (pagerduty/pagerduty_metrics.py): READ-ONLY REST key
PAGERDUTY_API_KEY_RO=
